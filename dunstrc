# dunstrc — proposed configuration for 1:1 parity with the macOS dunst-overlay
# (SwiftUI floating panel at ~/.local/bin/dunst-overlay on the Mac).
#
# Source of truth: /Users/n0ko/.local/src/dunst-overlay.swift (Mac).
# Generated: 2026-05-27. DO NOT APPLY YET — review first.
#
# Mapping table: /tmp/mapping-table.md
# Original (pre-change) backup recommendation:
#   cp ~/.config/dunst/dunstrc ~/.config/dunst/dunstrc.before-overlay-parity.$(date +%Y%m%d-%H%M%S)

[global]
    monitor = 0
    follow = none

    # ── Geometry / spawn ─────────────────────────────────────────────────
    # Mac uses a fixed 320 px panel anchored 12 px from the top-right of the
    # visible screen frame. dunst's `width` accepts (min, max); making min=max
    # forces a fixed width. `offset = 12x23` places notifications flush directly
    # below the dwm/dwmblocks status bar (measured 23 px via xdotool active-window
    # y=23 on 2026-05-27). No Mac-parity Y inset — user wants flush, no gap.
    # 2026-05-27 14:45 size-match pass: lewis eDP-1 = 2560px/288mm (~226 DPI)
    # while mac 16" XDR = ~3456 native px / 344mm ~ retina 2x. Mac SwiftUI 320pt
    # panel renders physically ~73mm wide; lewis 320px panel was only ~36mm wide.
    # Scaling all geometry/typography by 2x to match physical size on lewis.
    width = (560, 560)
    height = (0, 600)
    origin = top-right
    offset = (24, 23)                # x doubled to 24; y stays at 23 (dwmblocks bar height, unchanged)
    scale = 1

    # ── Stacking ─────────────────────────────────────────────────────────
    notification_limit = 1        # only one on-screen at a time; queue depth shown via dwmblocks badge
    gap_size = 12                 # 2x mac-parity tile gap.

    # ── Transparency / frame / corner ────────────────────────────────────
    transparency = 0              # fully opaque (was 15; user reverted because dwm side panel was readable behind it)
    corner_radius = 20            # Mac 10pt @ retina 2x = 20px
    frame_width = 3               # Mac 1.5pt stroke @ 2x = 3px
    frame_color = "#00FFFF"
    separator_height = 0
    separator_color = frame

    # ── Padding ──────────────────────────────────────────────────────────
    # Mac inner padding 14pt @ 2x = 28px on all four sides.
    padding = 28
    horizontal_padding = 28
    text_icon_padding = 20        # mac HStack 10pt @ 2x

    # ── Progress bar (Mac overlay has none; keep dunst defaults disabled) ─
    progress_bar = false

    # ── Icon sizing ──────────────────────────────────────────────────────
    # Mac 40pt @ 2x = 80px icons.
    min_icon_size = 80
    max_icon_size = 80
    icon_position = left
    icon_path = /home/n0ko/.local/share/icons/:/home/n0ko/Pictures/

    # ── Typography ───────────────────────────────────────────────────────
    # Mac uses three VictorMonoNFM faces (Bold-13 title, Regular-12 body,
    # Medium-10 app-name). All sizes doubled for retina-equivalent physical size.
    font = VictorMono Nerd Font Mono 12
    line_height = 0
    markup = full

    # Format: app-name as small grey leader, title bold, body on next line.
    # Mac points doubled: 10pt->20pt (20480), 13pt->26pt (26624), 12pt->24pt (24576).
    format = "<span size='10240' foreground='#999999'>%a</span>\n<b><span size='13312'>%s</span></b>\n<span size='12288' foreground='#dddddd'>%b</span>"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 20
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    enable_posix_regex = true

    # ── Keybinds (preserved from current lewis dunstrc) ──────────────────
    close = ctrl+space
    close_all = ctrl+shift+space
    context = mod1+Right
    mouse_left_click = context,close_current
    mouse_middle_click = do_action, close_current
    dmenu = dmenu -m 2 -fn "VictorMono:size=11" -nf green -nb black -sb blue -p dunst

# ── Urgency themes (verbatim from dunst-overlay.swift themes dict) ───────
[urgency_low]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#00FFFF"
    timeout = 3

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#00FFFF"
    timeout = 3

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#8B0000"
    timeout = 0

# Per-notification frame color: green for claude-lazy-plugin (Shortcuts-min icon)
# Mirrors mac SwiftUI overlay ($FR=#a8ff3e in hookio.NotifyStyled).
[lazy-plugin-green-frame]
    appname = "claude-lazy-plugin"
    frame_color = "#a8ff3e"

# ─────────────────────────────────────────────────────────────────────────
# RULE PRESERVATION
#
# All existing per-app rule blocks from the current dunstrc (HTTP4XXResponsecode,
# KubeHpaScaling, capDatadogRecovery, gopherNuggets, paypal, reddit, discord,
# youTube, emails, gitlab, messages, capacity, ecco, dd-prod-alerts, test,
# updates, ai, charging, discharging, lowbattery, brightness, touchpad, package,
# merked, scrot, wifey, email, aws_check, wallpaper, rayne, agent-low/normal/
# critical, tool-low/normal/critical, tfmaster, claude-context-*, openbrain,
# ob-context-inject, ob1-write, computecommander) are preserved AS-IS by
# appending the current dunstrc tail starting at the first non-urgency rule
# block. They reference custom icons under ~/Pictures/ and inject their own
# bg/fg/frame colors — those overrides are still valid under the new [global]
# because the global only sets defaults that the rule blocks intentionally
# override.
#
# WHEN APPLYING:
#   1. cp current dunstrc to dunstrc.before-overlay-parity.<timestamp>
#   2. Replace the [global] + [urgency_*] sections with the blocks above.
#   3. Leave the rule blocks (everything from [HTTP4XXResponsecode] onward) intact.
#   4. dunstctl reload  OR  pkill dunst && dunst &
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
# [claude-intent] — intent-verification gate notifications (claude-hooks intent).
# Mac parity: matches the dunst-overlay intent theme on the mac host exactly.
#   icon  : precision-target-reticle-focus (semantic: intent events only)
#   bg    : #0d0d10  (near-black)
#   fg    : #D97757  (Claude terracotta)
#   frame : #D97757  (Claude terracotta — terminal-notifier Claude brand accent)
# appname is the FILTER key (required — a rule with only action keys is inert).
# ─────────────────────────────────────────────────────────────────────────
[claude-intent]
    appname = "claude-intent"
    background = "#0d0d10"
    foreground = "#D97757"
    frame_color = "#D97757"
    new_icon = precision-target-reticle-focus

# ─────────────────────────────────────────────────────────────────────────
# [pi-intent] — pi intent-gate notifications (pi-plugin-intent →
# Mutations.Warnings → piNotify). Mirrors [claude-intent] shape with a
# pi-distinct blue frame. No bespoke icon — π prefix is the identity.
# icon="" defeats any inherited theme icon.
# ─────────────────────────────────────────────────────────────────────────
[pi-intent]
    appname = "pi-intent"
    background = "#0d0d10"
    foreground = "#7FB4FF"
    frame_color = "#7FB4FF"
    icon = ""

# ─────────────────────────────────────────────────────────────────────────
# [pi-intent-eval] — pi tool-block / eval-block notifications.
# Mirrors the (rule-less) claude-intent-eval surface; pi gives it an
# explicit rule with a red frame to read as a hard block. icon="" same.
# ─────────────────────────────────────────────────────────────────────────
[pi-intent-eval]
    appname = "pi-intent-eval"
    background = "#1a1a2e"
    foreground = "#ff5555"
    frame_color = "#ff5555"
    icon = ""

# ─────────────────────────────────────────────────────────────────────────
# [pi-lazy-plugin] — pi lazy-loader green frame, mirroring
# [lazy-plugin-green-frame] for claude-lazy-plugin. icon="" same.
# ─────────────────────────────────────────────────────────────────────────
[pi-lazy-plugin]
    appname = "pi-lazy-plugin"
    frame_color = "#a8ff3e"
    icon = ""
