# ─────────────────────────────────────────────────────────────────────────
# [claude-intent] — intent-verification gate notifications (claude-hooks intent).
# Mac parity: matches the dunst-overlay intent theme on the mac host exactly.
#   icon  : precision-target-reticle-focus (semantic: intent events only)
#   bg    : #0d0d10  (near-black)
#   fg    : #D97757  (Claude terracotta)
#   frame : #D97757  (Claude terracotta — terminal-notifier Claude brand accent)
# appname is the FILTER key (required — a rule with only action keys is inert).
# ─────────────────────────────────────────────────────────────────────────
[claude-intent]
    appname = "claude-intent"
    background = "#0d0d10"
    foreground = "#D97757"
    frame_color = "#D97757"
    new_icon = precision-target-reticle-focus

# ─────────────────────────────────────────────────────────────────────────
# [pi-intent] — pi intent-gate notifications (pi-plugin-intent →
# Mutations.Warnings → piNotify). Mirrors [claude-intent] shape with a
# pi-distinct blue frame. No bespoke icon — π prefix is the identity.
# icon="" defeats any inherited theme icon.
# ─────────────────────────────────────────────────────────────────────────
[pi-intent]
    appname = "pi-intent"
    background = "#0d0d10"
    foreground = "#7FB4FF"
    frame_color = "#7FB4FF"

# ─────────────────────────────────────────────────────────────────────────
# [pi-intent-eval] — pi tool-block / eval-block notifications.
# Mirrors the (rule-less) claude-intent-eval surface; pi gives it an
# explicit rule with a red frame to read as a hard block. icon="" same.
# ─────────────────────────────────────────────────────────────────────────
[pi-intent-eval]
    appname = "pi-intent-eval"
    background = "#1a1a2e"
    foreground = "#ff5555"
    frame_color = "#7FB4FF"

# ─────────────────────────────────────────────────────────────────────────
# [pi-lazy-plugin] — pi lazy-loader green frame, mirroring
# [lazy-plugin-green-frame] for claude-lazy-plugin. icon="" same.
# ─────────────────────────────────────────────────────────────────────────
[pi-lazy-plugin]
    appname = "pi-lazy-plugin"
    frame_color = "#7FB4FF"

# ─────────────────────────────────────────────────────────────────────────
# [pi-context-request] — pi context-classifier notifications. Mirrors
# [pi-intent] shape with the same pi-blue frame. icon="" same.
# ─────────────────────────────────────────────────────────────────────────
[pi-context-request]
    appname = "pi-context-request"
    background = "#0d0d10"
    foreground = "#7FB4FF"
    frame_color = "#7FB4FF"

# ─────────────────────────────────────────────────────────────────────────
# [killer] — process-killer notifications from lister.sh run_killer()
# (the "television multi-function" launcher that replaced the standalone
# killer script). Restores the deadpool theming the old [merked] rule used
# to apply (summary .*Merked.* → deadpool thumbs-up). lister.sh now sets an
# explicit appname via `notify-send -a killer`, so this rule matches by
# appname like every other live rule.
#   icon: deadpool thumbs-up sticker
# ─────────────────────────────────────────────────────────────────────────
[killer]
    appname = "killer"
    new_icon = "~/Pictures/stickers/deadpool/marvel-deadpool-thumbs-up-sticker.png"

# ─────────────────────────────────────────────────────────────────────────
# [to-statusbar] — route notifications into the dwmblocks status bar
# instead of drawing a popup over whatever is on screen.
#
# notif-sink records the notification to /tmp/dwmblocks_notif and signals
# dwmblocks (SIGRTMIN+18); the sb-notif block renders it as a pill at the
# LEFT edge of the right-aligned status, where it shrinks dwm's elastic
# window-title region rather than pushing other blocks off the bar.
#
# skip_display suppresses the popup. [global] already sets
# always_run_script = true, which is what keeps the script firing for
# suppressed notifications. History is deliberately untouched: the full,
# untruncated text stays available via `dunstctl history`.
#
# summary is a POSIX regex here, not a glob — [global] sets
# enable_posix_regex = true, so the catch-all is ".*" and NOT "*".
#
# Rules apply in file order and later rules win, so the popup exemptions
# below MUST stay after this block.
#
# NOTE: this block is duplicated verbatim in the rendered dunstrc. The
# template only parameterises geometry (@@WIDTH@@, @@OFFSET_X@@, ...), so
# rules must be kept in sync in both files by hand.
# ─────────────────────────────────────────────────────────────────────────
[to-statusbar]
    summary = ".*"
    script = /home/n0ko/.local/bin/statusbar/notif-sink
    skip_display = true

# ── Popup exemptions: rayne webhooks ONLY ────────────────────────────────
# Everything else is bar-only. [to-statusbar] above matches every
# notification including urgency=critical, so nothing else draws over the
# screen. Consequence, accepted deliberately: a critical failure appears
# only as a bar pill that self-clears after DWMBLOCKS_NOTIF_TTL (8s).
# `dunstctl history` keeps the full text; `dunstctl history-pop` replays it.
#
# rayne is the webhook server -- its alerts are the one class that must
# interrupt rather than scroll past in the bar. timeout = 0 makes them
# persist until dismissed, matching the long-standing [rayne] rule.
#
# The appname is "Rayne" (capital R). [global] sets enable_posix_regex, so
# matching is a case-SENSITIVE regex; [Rr] guards against case variance at
# the emitter.
#
# This must stay AFTER [to-statusbar] -- rules apply in file order and
# later rules win. Moving it above would silently re-suppress it.
[popup-rayne]
    appname = "[Rr]ayne"
    skip_display = false
    timeout = 0

# Note: notif-sink's display-switch handling is independent of all this. It
# keys off the appname to re-read the output width and re-scale the field
# for eDP-1 vs HDMI-1, and still runs while the popup is suppressed.
